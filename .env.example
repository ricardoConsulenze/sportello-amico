# Copy to .env (never commit .env)

# --- backend (server.py) ---
ANTHROPIC_API_KEY=
MOCK=0                       # 1 = canned answers, no AI (labelled in the UI)

# --- frontend (nginx) ---
APP_ENV=production
# Origin of the LangGraph Agent Server, no path. Empty = chat box hidden.
#   self-hosted in compose: http://langgraph:8000   LangGraph Platform: https://<deployment>.langgraph.app
LANGGRAPH_URL=
LANGGRAPH_API_KEY=           # added by nginx server-side, never sent to the browser
LANGGRAPH_ASSISTANT_ID=sportello

# Only if the frontend is hosted on a different domain from the backend (no nginx proxy):
# API_BASE_URL=https://api.example.it   (frontend)  +  ALLOWED_ORIGINS=https://www.example.it (backend)
# CSP_CONNECT_EXTRA=https://api.example.it
