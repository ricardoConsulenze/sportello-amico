# Rendered by the nginx entrypoint with envsubst: only ${VARS} defined in the environment are replaced.
# privacy (P3): no request bodies, no query strings in the access log
# IP truncated to /24 (IPv4) or dropped (IPv6): with the path it would reveal who prepares a disability pass application
map $remote_addr $ip_anon {
  ~^(?<p>\d+\.\d+\.\d+)\.\d+$ $p.0;
  default                           "-";
}
# thread ids work as access keys to a chat: never log them
map $uri $uri_safe {
  "~^/langgraph/threads/[0-9a-fA-F-]{36}(?<rest>.*)$" /langgraph/threads/:id$rest;
  default $uri;
}
log_format privacy '$ip_anon [$time_local] "$request_method $uri_safe" $status $request_time';

limit_req_zone $binary_remote_addr zone=checks:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=chat:10m rate=30r/m;

# one Cache-Control per path: an add_header inside a location would drop the security headers below
map $uri $cache_control {
  default      "no-cache";                 # file names are not hashed: always revalidate
  ~^/vendor/   "public, max-age=86400";
  /config.js   "no-store";
  ~^/(api|demo|langgraph)/ "";             # the backend sets its own (empty = header not added)
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;

  access_log /dev/stdout privacy;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header X-Frame-Options DENY always;
  add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;
  add_header Cache-Control $cache_control always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  # heic2any (HEIC -> JPG) needs 'unsafe-eval' and blob: workers
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self' blob: data: ${CSP_CONNECT_EXTRA}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  location = /healthz { access_log off; return 200 "ok\n"; }

  location / { try_files $uri $uri/ /index.html; }

  # ---- Python backend (Claude document checks) ----
  location /api/ {
    limit_req zone=checks burst=4 nodelay;
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 30m;     # matches MAX_BODY in server.py
    client_body_buffer_size 30m;  # keep uploaded medical documents in memory, never in a temp file (P2)
    proxy_read_timeout 300s;      # Claude with effort "high" can take a while
  }
  location = /api/status { proxy_pass ${BACKEND_URL}; }
  location /demo/ { proxy_pass ${BACKEND_URL}; }

  # ---- LangGraph chatbot (generated by 40-app-config.sh) ----
  include /etc/nginx/snippets/langgraph.conf;

  limit_req_status 429;

  # errors from nginx itself in the same {"errore": ...} format the frontend shows to people
  error_page 413 = @too_large;
  error_page 429 = @too_many;
  error_page 502 503 504 = @backend_down;
  location @too_large {
    default_type application/json;
    return 413 '{"errore": "File troppo grandi. Ogni file deve stare sotto i 5 MB."}';
  }
  location @too_many {
    default_type application/json;
    return 429 '{"errore": "Troppe richieste in poco tempo. Aspetta un minuto e riprova."}';
  }
  location @backend_down {
    default_type application/json;
    return 502 '{"errore": "Il servizio non risponde in questo momento. Riprova tra poco."}';
  }
}
